# Template file for 'xbpretty'
pkgname=xbpretty
version=0.3.2
revision=1
build_style=go
go_import_path="github.com/soubarnak/xbpretty"
go_package="${go_import_path}/cmd/xbpretty"
go_ldflags="-X ${go_import_path}/internal/cli.Version=${version}"
depends="xbps"
short_desc="Friendlier front end for the xbps package manager"
maintainer="soubarnak <soubarna@live.in>"
license="MIT"
homepage="https://github.com/soubarnak/xbpretty"
distfiles="https://github.com/soubarnak/xbpretty/archive/refs/tags/xbpretty-v${version}.tar.gz"
checksum=291ad4fadb0bbef2a85302a476ffa3800737a301645bc51e6a7d4a8bf1c75953

pre_build() {
	# One static binary with no runtime dependency but xbps (NFR-001). Without
	# this, os/user pulls in cgo on a native build.
	export CGO_ENABLED=0
}

post_install() {
	# The argv[0] aliases: one binary, six names (FR-001).
	for alias in xbp xbp-install xbp-remove xbp-upgrade xbp-autoremove xbp-update; do
		ln -s xbpretty "${DESTDIR}/usr/bin/${alias}"
	done
	# Pre-generated by `make completions`: a cross build cannot run the binary
	# it just built (FR-024).
	vcompletion completions/xbpretty.bash bash xbpretty
	vcompletion completions/_xbpretty zsh xbpretty
	vcompletion completions/xbpretty.fish fish xbpretty
	vlicense LICENSE
}
