#!/bin/sh
# Stub xbps-remove: records how it was called and behaves like real xbps
# enough for the acceptance tests - a dry run prints the plan, a real run
# succeeds or fails according to the fixture variables.
printf '%s %s\n' "${0##*/}" "$*" >> "${XB_STUB_LOG:-/dev/null}"
# A call is a plan when its first argument is a flag cluster (starts with -,
# not --) containing n. Nothing after the first argument counts.
case "${1:-}" in
  --*) ;;
  -*n*)
    # XB_STUB_REMOVE_STDOUT overrides the plan for xbps-remove only, so a test
    # can give the primary transaction and the implicit orphan transaction
    # different plans. When it is unset, the shared fixture applies.
    out="${XB_STUB_STDOUT:-}"
    case " $* " in
      *" -o "*)
        if [ "${XB_STUB_REMOVE_STDOUT+x}" = x ]; then
          out="$XB_STUB_REMOVE_STDOUT"
        fi
        ;;
    esac
    printf '%s' "$out"
    printf '%s' "${XB_STUB_STDERR:-}" >&2
    exit "${XB_STUB_PLAN_EXIT:-0}"
    ;;
esac
printf '%s' "${XB_STUB_RUN_STDOUT-${XB_STUB_STDOUT:-}}"
printf '%s' "${XB_STUB_RUN_STDERR-${XB_STUB_STDERR:-}}" >&2
code="${XB_STUB_REMOVE_EXIT-${XB_STUB_EXIT:-0}}"
# XB_STUB_RUN_EXIT applies only to the real (-y) invocation, so a test can
# plan successfully and fail the transaction itself. XB_STUB_REMOVE_RUN_EXIT
# is the remove-specific override a two-phase replay needs to fail only its
# removal phase.
case "${1:-}" in
  -*y*)
    code="${XB_STUB_REMOVE_RUN_EXIT-${XB_STUB_RUN_EXIT:-$code}}"
    # A successful real run flips the fixture to its after state so the
    # history snapshot sees the change; a failed run leaves it alone.
    [ "$code" = 0 ] && [ -n "${XB_STUB_AFTER_MARK:-}" ] && : > "$XB_STUB_AFTER_MARK" ;;
esac
exit "$code"
