#!/bin/sh
# Stub xbps-uhelper: records how it was called and answers the comparison
# fixture. Real cmpver exits 1 when the first version is greater, 0 when they
# are equal and 255 when the first is less.
printf '%s %s\n' "${0##*/}" "$*" >> "${XB_STUB_LOG:-/dev/null}"
case "${1:-}" in
  cmpver)
    exit "${XB_STUB_CMPVER_EXIT:-255}" ;;
esac
exit 0
